<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>MiniExcel</id>
    <version>1.46.0</version>
    <title>MiniExcel</title>
    <authors>Wei Lin, Michele Bastione, PING-HSIU SHIH, Amos(izanhzh), eynarhaji, Mini-Software team</authors>
    <license type="expression">Apache-2.0</license>
    <licenseUrl>https://licenses.nuget.org/Apache-2.0</licenseUrl>
    <icon>icon.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://github.com/mini-software/MiniExcel</projectUrl>
    <description>Lightweight, fast and simple .NET processing tool for importing, exporting and templating spreadsheets.</description>
    <releaseNotes>https://github.com/mini-software/MiniExcel/tree/master/docs</releaseNotes>
    <copyright>Wei Lin, 2021 onwards</copyright>
    <tags>excel xlsx csv micro-helper mini openxml helper</tags>
    <repository type="Github" url="https://github.com/mini-software/MiniExcel" branch="refs/heads/v1.x-maintenance" commit="e5b13f9439196af300255a51f7160934df2d59de" />
    <dependencies>
      <group targetFramework=".NETFramework4.5">
        <dependency id="System.IO.Compression" version="4.3.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETFramework4.6.1">
        <dependency id="Microsoft.Bcl.AsyncInterfaces" version="10.0.9" exclude="Build,Analyzers" />
        <dependency id="System.IO.Compression" version="4.3.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net8.0" />
      <group targetFramework="net9.0" />
      <group targetFramework="net10.0" />
      <group targetFramework=".NETStandard2.0">
        <dependency id="Microsoft.Bcl.AsyncInterfaces" version="10.0.9" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>