  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InspectionModelInfo
  _title: "\u041A\u0430\u0442\u0443\u0448\u043A\u0430"
  _description: "\u0417\u0430\u043C\u043A\u043D\u0443\u0442\u0430\u044F \u043C\u0430\u0433\u043D\u0438\u0442\u043D\u0430\u044F \u0446\u0435\u043F\u044C, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0441\u043B\u0443\u0436\u0438\u0442 \u0434\u043B\u044F \u043B\u043E\u043A\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u0438 \u0438 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F \u043C\u0430\u0433\u043D\u0438\u0442\u043D\u043E\u0433\u043E \u043F\u043E\u0442\u043E\u043A\u0430, \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u0435\u043C\u043E\u0433\u043E \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u0442\u043E\u043A\u043E\u043C \u0432 \u043E\u0431\u043C\u043E\u0442\u043A\u0430\u0445. \u041E\u043D \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043A\u043B\u044E\u0447\u0435\u0432\u043E\u0439 \u0444\u0443\u043D\u043A\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0439 \u0447\u0430\u0441\u0442\u044C\u044E \u0442\u0440\u0430\u043D\u0441\u0444\u043E\u0440\u043C\u0430\u0442\u043E\u0440\u0430, \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u043C\u043E\u043D\u0442\u0438\u0440\u0443\u044E\u0442\u0441\u044F \u043E\u0431\u043C\u043E\u0442\u043A\u0438. "
