  m_Script: {fileID: 11500000, guid: 708b8bc71e85a6b429847a5ac254dac3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InspectionModelInfo
  _title: "\u0422\u0440\u0430\u043D\u0441\u0444\u043E\u0440\u043C\u0430\u0442\u043E\u0440"
  _description: "\u041F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F \u043F\u0440\u0435\u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u044F \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u044D\u043D\u0435\u0440\u0433\u0438\u0438 \u043F\u0435\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0433\u043E \u0442\u043E\u043A\u0430 \u0441 \u043E\u0434\u043D\u043E\u0433\u043E \u0443\u0440\u043E\u0432\u043D\u044F \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u044F \u043D\u0430 \u0434\u0440\u0443\u0433\u043E\u0439. \u0412 \u043C\u0430\u0441\u043B\u044F\u043D\u044B\u0445 \u0442\u0440\u0430\u043D\u0441\u0444\u043E\u0440\u043C\u0430\u0442\u043E\u0440\u0430\u0445 \u043C\u0430\u0441\u043B\u043E \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0443\u044E \u0438\u0437\u043E\u043B\u044F\u0446\u0438\u044E \u0438 \u043E\u0442\u0432\u043E\u0434 \u0442\u0435\u043F\u043B\u0430 \u043E\u0442 \u043E\u0431\u043C\u043E\u0442\u043E\u043A \u0438 \u043C\u0430\u0433\u043D\u0438\u0442\u043E\u043F\u0440\u043E\u0432\u043E\u0434\u0430."
