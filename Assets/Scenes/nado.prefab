    RefIds:
    - rid: 1332834693188419846
      type: {class: ShowMessageAction, ns: , asm: Assembly-CSharp}
      data:
        _message: "\u041F\u0440\u043E\u0432\u0435\u0441\u0442\u0438 \u0432\u0438\u0437\u0443\u0430\u043B\u044C\u043D\u044B\u0439
          \u043E\u0441\u043C\u043E\u0442\u0440 \u0442\u0435\u043F\u043B\u043E\u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
          \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F,
          \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0442\u044C \u043D\u0430\u043B\u0438\u0447\u0438\u0435
          \u043D\u0435\u0438\u0441\u043F\u0440\u0430\u0432\u043D\u043E\u0441\u0442\u0435\u0439
          \u0442\u0440\u0443\u0431\u043E\u043F\u0440\u043E\u0432\u043E\u0434\u043D\u043E\u0439
          \u043E\u0431\u0432\u044F\u0437\u043A\u0438 \u0438 \u0430\u0440\u043C\u0430\u0442\u0443\u0440\u044B,
          \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u0442\u044C \u043C\u0435\u0441\u0442\u043E
          \u043F\u0440\u043E\u0442\u0435\u0447\u043A\u0438, \u0434\u043E\u043B\u043E\u0436\u0438\u0442\u044C
          \u043E \u0432\u044B\u044F\u0432\u043B\u0435\u043D\u043D\u043E\u043C \u0434\u0435\u0444\u0435\u043A\u0442\u0435
          \u043F\u043E \u0440\u0430\u0434\u0438\u043E\u0441\u0442\u0430\u043D\u0446\u0438\u0438.\r\n"
