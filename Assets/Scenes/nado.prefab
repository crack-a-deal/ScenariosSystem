          m_StringArgument: 
          m_BoolArgument: 1
        m_CallState: 2
  _hint: "\u0421\u043E\u043E\u0431\u0449\u0438\u0442\u0435 \u043F\u043E \u0440\u0430\u0446\u0438\u0438
    \u043E \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u0438
    \u0441\u0431\u0440\u043E\u0441\u0430 \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u044F
    \u0438 \u0441\u043B\u0438\u0432\u0430 \u0432\u043E\u0434\u044B \u0438\u0437 \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u0435\u043C\u043E\u0433\u043E
    \u043A\u043E\u043D\u0442\u0443\u0440\u0430"
  _errors: []
  references:
    version: 2
    RefIds:
    - rid: 1332835185153802320
      type: {class: EventCondition, ns: , asm: Assembly-CSharp}
      data:
        _eventType: 1
        _source: {fileID: 0}
    - rid: 1332835185153802321
      type: {class: ShowMessageAction, ns: , asm: Assembly-CSharp}
      data:
        _message: "\u0414\u0438\u0441\u043F\u0435\u0442\u0447\u0435\u0440, \u0434\u043E\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
          \u043E\u043F\u0435\u0440\u0430\u0442\u043E\u0440. \u041F\u0440\u0438 \u043E\u0441\u043C\u043E\u0442\u0440\u0435
          \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u043E
          \u043F\u0430\u0440\u0435\u043D\u0438\u0435 \u043D\u0430 \u0444\u043B\u0430\u043D\u0446\u0435\u0432\u043E\u043C
          \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u0438. \u0422\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F
          \u0440\u0435\u043C\u043E\u043D\u0442 \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u044F
          \u0438 \u0437\u0430\u043C\u0435\u043D\u0430 \u0443\u043F\u043B\u043E\u0442\u043D\u0435\u043D\u0438\u044F"
