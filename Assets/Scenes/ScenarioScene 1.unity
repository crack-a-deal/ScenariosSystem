  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Step
  Id: 1
  Title: "\u041F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u0435 \u0437\u0430\u0434\u0430\u043D\u0438\u044F"
  _completionCondition:
    rid: 1332834693188419851
  _onEnter:
  - rid: 1332834693188419846
  _onEnterEvent:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 2532327007894267095}
        m_TargetAssemblyTypeName: PlayerController, Assembly-CSharp
        m_MethodName: SetLookEnabled
        m_Mode: 6
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
  _onComplete:
  - rid: 1332834693188419848
  _onCompleteEvent:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 2532327007894267095}
        m_TargetAssemblyTypeName: PlayerController, Assembly-CSharp
        m_MethodName: SetLookEnabled
        m_Mode: 6
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 1
        m_CallState: 2
  _hint: "\u041F\u0435\u0440\u0435\u0434 \u043D\u0430\u0447\u0430\u043B\u043E\u043C
    \u0441\u043B\u0438\u0432\u0430 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
    \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C \u0432\u0435\u0441\u044C
    \u0441\u043B\u0438\u0432\u043D\u043E\u0439 \u0442\u0440\u0430\u043A\u0442. \u041D\u0435
    \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0439\u0442\u0435 \u0441\u043B\u0438\u0432\u043D\u043E\u0439
    \u044D\u043B\u0435\u043C\u0435\u043D\u0442 \u0434\u043E \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F
    \u0448\u043B\u0430\u043D\u0433\u0430 \u0438 \u0451\u043C\u043A\u043E\u0441\u0442\u0438+"
  _errors: []
  references:
    version: 2
    RefIds:
    - rid: 1332834693188419846
      type: {class: ShowMessageAction, ns: , asm: Assembly-CSharp}
      data:
        _message: "\u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C
          \u0433\u0440\u0443\u0437\u043E\u043F\u043E\u0434\u044A\u0451\u043C\u043D\u043E\u0435
          \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u0435,
          \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u0442\u044C \u0441\u0442\u0440\u043E\u043F\u043E\u0432\u043A\u0443
          \u043A\u0430\u0442\u0443\u0448\u0435\u0447\u043D\u043E\u0433\u043E \u0443\u0437\u043B\u0430,
          \u043F\u0440\u043E\u0438\u0437\u0432\u0435\u0441\u0442\u0438 \u043F\u0440\u043E\u0431\u043D\u044B\u0439
          \u043F\u043E\u0434\u044A\u0451\u043C, \u0438\u0437\u0432\u043B\u0435\u0447\u044C
          \u043A\u0430\u0442\u0443\u0448\u043A\u0438 \u0438\u0437 \u0431\u0430\u043A\u0430
          \u0442\u0440\u0430\u043D\u0441\u0444\u043E\u0440\u043C\u0430\u0442\u043E\u0440\u0430
          \u0438 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u0438\u0445
          \u043D\u0430 \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u043D\u0443\u044E
          \u043E\u043F\u043E\u0440\u0443"
        _messageBox: {fileID: 4716055284544389767}
        _messageLabel: {fileID: 2845151443828133852}
    - rid: 1332834693188419848
      type: {class: HideMessageAction, ns: , asm: Assembly-CSharp}
