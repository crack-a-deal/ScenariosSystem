MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 919132148178326257}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 708b8bc71e85a6b429847a5ac254dac3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InspectionModelInfo
  _title: "\u0428\u0430\u0440\u043E\u0432\u043E\u0439 \u043A\u0440\u0430\u043D"
  _description: "\u0417\u0430\u043F\u043E\u0440\u043D\u0430\u044F \u0430\u0440\u043C\u0430\u0442\u0443\u0440\u0430
    \u0441 \u0432\u0440\u0430\u0449\u0430\u044E\u0449\u0438\u043C\u0441\u044F \u0448\u0430\u0440\u043E\u043C,
    \u0438\u043C\u0435\u044E\u0449\u0438\u043C \u0441\u043A\u0432\u043E\u0437\u043D\u043E\u0435
    \u043E\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u0435. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F
    \u0434\u043B\u044F \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u044F \u0438 \u043F\u0435\u0440\u0435\u043A\u0440\u044B\u0442\u0438\u044F
    \u043F\u043E\u0442\u043E\u043A\u0430 \u0432\u043E\u0434\u044B, \u043C\u0430\u0441\u043B\u0430,
    \u0433\u0430\u0437\u0430 \u0438\u043B\u0438 \u0434\u0440\u0443\u0433\u043E\u0433\u043E
    \u0440\u0430\u0431\u043E\u0447\u0435\u0433\u043E \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0430
    \u0432 \u0442\u0440\u0443\u0431\u043E\u043F\u0440\u043E\u0432\u043E\u0434\u0430\u0445."
