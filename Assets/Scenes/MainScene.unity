  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InspectionModelInfo
  _title: "\u0412\u043E\u0434\u043E\u0433\u0440\u0435\u0439\u043D\u044B\u0439 \u043A\u043E\u0442\u0451\u043B"
  _description: "\u0422\u0435\u043F\u043B\u043E\u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E, \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u043E\u0435
    \u0434\u043B\u044F \u043D\u0430\u0433\u0440\u0435\u0432\u0430 \u0432\u043E\u0434\u044B
    \u0437\u0430 \u0441\u0447\u0451\u0442 \u0441\u0436\u0438\u0433\u0430\u043D\u0438\u044F
    \u0442\u043E\u043F\u043B\u0438\u0432\u0430 \u0438\u043B\u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F
    \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u044D\u043D\u0435\u0440\u0433\u0438\u0438. \u041F\u0440\u0438\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F
    \u0432 \u0441\u0438\u0441\u0442\u0435\u043C\u0430\u0445 \u043E\u0442\u043E\u043F\u043B\u0435\u043D\u0438\u044F,
    \u0433\u043E\u0440\u044F\u0447\u0435\u0433\u043E \u0432\u043E\u0434\u043E\u0441\u043D\u0430\u0431\u0436\u0435\u043D\u0438\u044F
    \u0438 \u043F\u0440\u043E\u043C\u044B\u0448\u043B\u0435\u043D\u043D\u043E\u0433\u043E
    \u0442\u0435\u043F\u043B\u043E\u0441\u043D\u0430\u0431\u0436\u0435\u043D\u0438\u044F."
