  _title: "\u0426\u0438\u0440\u043A\u0443\u043B\u044F\u0446\u0438\u043E\u043D\u043D\u044B\u0439
    \u043D\u0430\u0441\u043E\u0441"
  _description: "\u0423\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0449\u0435\u0435
    \u043F\u0440\u0438\u043D\u0443\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435
    \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435 \u0442\u0435\u043F\u043B\u043E\u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044F
    \u043F\u043E \u0442\u0440\u0443\u0431\u043E\u043F\u0440\u043E\u0432\u043E\u0434\u0430\u043C.
    \u041F\u0440\u0438\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F \u0432 \u0441\u0438\u0441\u0442\u0435\u043C\u0430\u0445
    \u043E\u0442\u043E\u043F\u043B\u0435\u043D\u0438\u044F, \u043E\u0445\u043B\u0430\u0436\u0434\u0435\u043D\u0438\u044F
    \u0438 \u0433\u043E\u0440\u044F\u0447\u0435\u0433\u043E \u0432\u043E\u0434\u043E\u0441\u043D\u0430\u0431\u0436\u0435\u043D\u0438\u044F
    \u0434\u043B\u044F \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u044F
    \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0439 \u0446\u0438\u0440\u043A\u0443\u043B\u044F\u0446\u0438\u0438
    \u0436\u0438\u0434\u043A\u043E\u0441\u0442\u0438."
--- !u!33 &3469287838501095406
