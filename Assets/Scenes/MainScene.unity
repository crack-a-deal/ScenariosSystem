  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 708b8bc71e85a6b429847a5ac254dac3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InspectionModelInfo
  _title: "\u0401\u043C\u043A\u043E\u0441\u0442\u044C \u043F\u043E\u0434 \u043C\u0430\u0441\u043B\u043E"
  _description: "\u0420\u0435\u0437\u0435\u0440\u0432\u0443\u0430\u0440 \u0434\u043B\u044F
    \u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F, \u0441\u0431\u043E\u0440\u0430
    \u0438\u043B\u0438 \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0433\u043E
    \u0440\u0430\u0437\u043C\u0435\u0449\u0435\u043D\u0438\u044F \u0442\u0440\u0430\u043D\u0441\u0444\u043E\u0440\u043C\u0430\u0442\u043E\u0440\u043D\u043E\u0433\u043E
    \u043C\u0430\u0441\u043B\u0430 \u043F\u0440\u0438 \u0440\u0435\u043C\u043E\u043D\u0442\u0435,
    \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u043C \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u0438
    \u0438 \u044D\u043A\u0441\u043F\u043B\u0443\u0430\u0442\u0430\u0446\u0438\u0438
    \u043C\u0430\u0441\u043B\u043E\u043D\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u043D\u043E\u0433\u043E
    \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F."
