  m_Script: {fileID: 11500000, guid: 708b8bc71e85a6b429847a5ac254dac3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InspectionModelInfo
  _title: "\u0412\u0432\u043E\u0434\u044B \u041D\u041D (\u043D\u0438\u0437\u043A\u043E\u0433\u043E
    \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u044F)"
  _description: "\u0418\u0437\u043E\u043B\u0438\u0440\u0443\u044E\u0449\u0438\u0435
    \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0449\u0438\u0435
    \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0435 \u043F\u0440\u043E\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435
    \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u043E\u0432 \u043D\u0438\u0437\u043A\u043E\u0433\u043E
    \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u044F \u0447\u0435\u0440\u0435\u0437
    \u043A\u043E\u0440\u043F\u0443\u0441 \u0442\u0440\u0430\u043D\u0441\u0444\u043E\u0440\u043C\u0430\u0442\u043E\u0440\u0430
    \u0438\u043B\u0438 \u0434\u0440\u0443\u0433\u043E\u0433\u043E \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F."
