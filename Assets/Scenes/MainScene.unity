--- !u!114 &3341050002341356003
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 520685186892143119}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 708b8bc71e85a6b429847a5ac254dac3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InspectionModelInfo
  _title: "\u041A\u0430\u0442\u0443\u0448\u043A\u0430"
  _description: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442 \u0432 \u0432\u0438\u0434\u0435
    \u043E\u0431\u043C\u043E\u0442\u043A\u0438 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0430,
    \u0441\u043E\u0437\u0434\u0430\u044E\u0449\u0438\u0439 \u043C\u0430\u0433\u043D\u0438\u0442\u043D\u043E\u0435
    \u043F\u043E\u043B\u0435 \u043F\u0440\u0438 \u043F\u0440\u043E\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0438
    \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0442\u043E\u043A\u0430. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F
    \u0432 \u0442\u0440\u0430\u043D\u0441\u0444\u043E\u0440\u043C\u0430\u0442\u043E\u0440\u0430\u0445,
    \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043C\u0430\u0433\u043D\u0438\u0442\u043D\u044B\u0445
    \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430\u0445 \u0438 \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0430\u043F\u043F\u0430\u0440\u0430\u0442\u0430\u0445."
