--- !u!114 &7727499406896996047
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7727499406896996046}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 708b8bc71e85a6b429847a5ac254dac3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InspectionModelInfo
  _title: "\u042D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0448\u043A\u0430\u0444"
  _description: "\u041A\u043E\u0440\u043F\u0443\u0441 \u0434\u043B\u044F \u0440\u0430\u0437\u043C\u0435\u0449\u0435\u043D\u0438\u044F
    \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0430\u043F\u043F\u0430\u0440\u0430\u0442\u043E\u0432, \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u0445
    \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432, \u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u043E\u0432 \u0438 \u0441\u0438\u0441\u0442\u0435\u043C
    \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F. \u041E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442
    \u0437\u0430\u0449\u0438\u0442\u0443 \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F
    \u0438 \u0443\u0434\u043E\u0431\u0441\u0442\u0432\u043E \u0435\u0433\u043E \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u044F."
