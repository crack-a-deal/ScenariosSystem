  m_Script: {fileID: 11500000, guid: 708b8bc71e85a6b429847a5ac254dac3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InspectionModelInfo
  _title: "\u0420\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435
    \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E"
  _description: "\u041A\u043E\u043C\u043F\u043B\u0435\u043A\u0441 \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0430\u043F\u043F\u0430\u0440\u0430\u0442\u043E\u0432, \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044B\u0439
    \u0434\u043B\u044F \u043F\u0440\u0438\u0451\u043C\u0430 \u0438 \u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u044F
    \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u044D\u043D\u0435\u0440\u0433\u0438\u0438,
    \u0430 \u0442\u0430\u043A\u0436\u0435 \u0437\u0430\u0449\u0438\u0442\u044B \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0446\u0435\u043F\u0435\u0439 \u043E\u0442 \u043F\u0435\u0440\u0435\u0433\u0440\u0443\u0437\u043E\u043A
    \u0438 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0445 \u0437\u0430\u043C\u044B\u043A\u0430\u043D\u0438\u0439."
