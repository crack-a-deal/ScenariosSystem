        _message: "\u0412\u044B\u043F\u043E\u043B\u043D\u0438\u0442\u0435 \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u0443\u044E
          \u0440\u0430\u0437\u0431\u043E\u0440\u043A\u0443 \u043A\u0430\u0442\u0443\u0448\u0435\u0447\u043D\u043E\u0433\u043E
          \u0443\u0437\u043B\u0430, \u0438\u0437\u0432\u043B\u0435\u0447\u0451\u043D\u043D\u043E\u0433\u043E
          \u0438\u0437 \u0431\u0430\u043A\u0430 \u0442\u0440\u0430\u043D\u0441\u0444\u043E\u0440\u043C\u0430\u0442\u043E\u0440\u0430.
          \u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u044C\u0442\u0435 \u0440\u0430\u0431\u043E\u0447\u0435\u0435
          \u043C\u0435\u0441\u0442\u043E, \u0441\u043D\u0438\u043C\u0438\u0442\u0435
          \u043F\u0440\u0435\u0434\u0443\u0441\u043C\u043E\u0442\u0440\u0435\u043D\u043D\u044B\u0435
          \u043A\u0440\u0435\u043F\u0451\u0436\u043D\u044B\u0435 \u0438 \u0444\u0438\u043A\u0441\u0438\u0440\u0443\u044E\u0449\u0438\u0435
          \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u044B, \u0440\u0430\u0437\u0434\u0435\u043B\u0438\u0442\u0435
          \u043A\u0430\u0442\u0443\u0448\u0435\u0447\u043D\u044B\u0439 \u0443\u0437\u0435\u043B
          \u0438 \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u044C\u0442\u0435
          \u0434\u0435\u0442\u0430\u043B\u0438 \u043A \u0434\u0438\u0430\u0433\u043D\u043E\u0441\u0442\u0438\u043A\u0435"
        _messageBox: {fileID: 0}
        _messageLabel: {fileID: 0}
